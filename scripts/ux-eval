import signal
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
UX_DIR = ROOT / "ux"
SCENARIOS_PATH = UX_DIR / "scenarios.json"
PRINCIPLES_PATH = UX_DIR / "principles.md"
DECISIONS_PATH = UX_DIR / "decisions.jsonl"
RUNS_DIR = UX_DIR / "runs"

ROLES = {
    "workflow": (
        "Judge information architecture and task flow. Determine whether the visible object, "
        "current scope, next action, and result are predictable without prior product knowledge."
    ),
    "interaction": (
        "Judge selection, filtering, keyboard ownership, focus, loading, failure recovery, and "
        "whether controls keep their promises across the stated interaction trace."
    ),
    "visual": (
        "Judge hierarchy, density, alignment, typography, emphasis, and responsive-window "
        "behavior. Treat visual polish as support for the task, not decoration."
    ),
    "simplifier": (
        "Find competing controls, duplicated concepts, needless containers, and labels that make "
        "the workflow harder. Prefer removal or one shared owner over added UI."
    ),
}

